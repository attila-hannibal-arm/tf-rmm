#!/usr/bin/env bash

fuzzbuild() {
  # Usage reminder
  local usage="Usage: fuzzbuild <coverage=0|1> <buildname> [np]"
  #set -Eeuo pipefail

  # Requires at least two arguments
  if (( $# < 2 )); then
    echo "Error: Not enough arguments."
    echo "$usage"
    return 1
  fi

  local coverage="$1"
  local buildname="$2"
  local mode="${3:-}"

  if [[ "$coverage" != "0" && "$coverage" != "1" ]]; then
    echo "Error: coverage must be 0 or 1"
    echo "$usage"
    return 1
  fi

  local buildtarget=""
  local compileflags=""
  local covg_conf=""
  local is_persistent="-DPERSISTENT_MODE"
  local fuzzroot="_Fuzz"
  if [[ -n "$RMM_BUILD_DIR" ]]; then
    fuzzroot="${RMM_BUILD_DIR}/Fuzz"
  fi
  local builddir="$fuzzroot/builds/$buildname"
  local sourcedir="."
  if [[ -n "$RMM_SOURCE_DIR" ]]; then
    sourcedir="$RMM_SOURCE_DIR"
  fi

  # If coverage=1, enable coverage config and activate venv
  if [[ "$coverage" == "1" ]]; then
    buildtarget="-- run-coverage"
    covg_conf="-DRMM_COVERAGE=ON"
    if [[ -f ".venv/bin/activate" ]]; then
      source ".venv/bin/activate"
    else
      echo "Warning: .venv/bin/activate not found, coverage report or corpus generation may fail."
    fi
  fi

  if [[ "$mode" == "np" ]]; then
    is_persistent=""
  fi

  cmake \
    -DLOG_LEVEL=50 \
    -DRMM_CONFIG="host_defcfg" \
    -DHOST_VARIANT="host_fuzz" \
    -DRMM_TOOLCHAIN="afl-llvm" \
    -DCMAKE_BUILD_TYPE="Debug" \
    -DFUZZ_BUILD_NAME="$buildname" \
    -DCMAKE_C_FLAGS="$is_persistent" \
    $covg_conf $compileflags \
    -S "$RMM_SOURCE_DIR" -B "$builddir"

  # Build
  local build_jobs="${FUZZ_BUILD_JOBS:-$(( $(nproc) / 2 ))}"
  ((build_jobs > 0)) || build_jobs=1
  cmake --build "$builddir" -j"$build_jobs"

  # Create bench directory and afl output link if missing
  mkdir -p "$fuzzroot/bench"
  ln -sfn /mnt/aflout "$fuzzroot/aflout"

  echo
  echo "Built with $is_persistent"
  echo "Suggested AFL commands:"
  echo "afl-fuzz -i \"$builddir/smc_corpus\" -o \"$fuzzroot/aflout/$buildname/\" -M \"m-$buildname\" -- \"./$builddir/Debug/rmm.elf\""
  echo "afl-fuzz -i \"$builddir/smc_corpus\" -o \"$fuzzroot/aflout/$buildname/\" -S \"s-$buildname\" -- \"./$builddir/Debug/rmm.elf\""

  echo
  echo "Fuzz for 1000 seconds:"
  echo "cmake --build \"$builddir\" -- run-fuzzer"
  echo "Benchmark for 100 seconds and generate reports:"
  echo "cmake --build \"$builddir\" -- quick-bench"

  echo
  echo "Execute with default corpus (Only for non-persistent mode):"
  echo "./$builddir/Debug/rmm.elf \"$builddir/smc_corpus/default.bin\""

  if [[ -n "$buildtarget" ]]; then
    echo
    echo "Generate coverage report:"
    echo "cmake --build \"$builddir\" $buildtarget"
  fi

  set +Eeuo pipefail
}

# Run AFL++ while replaying saved inputs under Valgrind.
# Usage: run_selective_valgrind <instance-output-dir> <reports-dir> \
#            <nonpersistent-binary> <timeout-ms> <afl-command> [args...]
# Requires Bash, setsid, timeout, sha256sum, and valgrind.
# Returns the AFL++ failure status, or 99 for nonzero replay results.
# Keep traps and worker state local to this subshell.
run_selective_valgrind() (
  local output="$1" reports="$2" binary="$3" timeout_ms="$4"
  shift 4
  local afl_pid="" replay_pid="" afl_status=0 status=0
  local checked=0 failures=0 found category case_file digest saved
  local afl_finished=no next_progress=0
  local timeout_seconds copy_error
  local -A seen=() seen_paths=()

  [[ "$timeout_ms" =~ ^[0-9]+$ ]] && (( 10#$timeout_ms > 0 )) || {
    echo "Valgrind timeout must be a positive integer in milliseconds" >&2
    return 1
  }
  printf -v timeout_seconds '%d.%03d' "$((10#$timeout_ms / 1000))" \
    "$((10#$timeout_ms % 1000))"
  mkdir -p "$reports" || return 1
  shopt -s nullglob

  cleanup_selective() {
    local pid
    for pid in "$replay_pid" "$afl_pid"; do
      [[ -n "$pid" ]] || continue
      if kill -0 -- "-$pid" 2>/dev/null; then
        kill -TERM -- "-$pid" 2>/dev/null
        sleep 0.2
        kill -KILL -- "-$pid" 2>/dev/null
      fi
      wait "$pid" 2>/dev/null
    done
    return 0
  }
  trap cleanup_selective EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  setsid "$@" &
  afl_pid=$!

  replay_progress() {
    local pending=0 progress_category progress_file
    if [[ $afl_finished == no ]] && ! kill -0 "$afl_pid" 2>/dev/null; then
      afl_finished=yes
      next_progress=$SECONDS
      echo "AFL++ finished; draining saved inputs under Valgrind before the summary."
      echo "Press Ctrl+C to stop replaying and summarize completed reports."
    fi
    if [[ $afl_finished == yes ]] &&
       { ((SECONDS >= next_progress)) || [[ ${1:-} == final ]]; }; then
      # Count paths without copying or hashing their contents.
      for progress_category in crashes hangs queue; do
        for progress_file in "$output/$progress_category"/id:*; do
          if [[ -f "$progress_file" && -z ${seen_paths[$progress_file]:-} ]]; then
            ((pending += 1))
          fi
        done
      done
      echo "Valgrind progress: $pending saved files left, $checked inputs checked, $failures nonzero replays."
      next_progress=$((SECONDS + ${FUZZ_PROGRESS_INTERVAL_SECONDS:-5}))
    fi
  }

  while :; do
    replay_progress
    found=no
    for category in crashes hangs queue; do
      for case_file in "$output/$category"/id:*; do
        # Treat saved paths as immutable; hash each path only once.
        [[ -z ${seen_paths[$case_file]:-} ]] || continue
        # The glob is a snapshot; AFL++ may remove entries during replays.
        [[ -f "$case_file" ]] || continue
        if ! copy_error=$(cp -- "$case_file" "$reports/.pending.bin" 2>&1); then
          [[ -e "$case_file" ]] || continue
          printf '%s\n' "$copy_error" >&2
          return 1
        fi
        digest=$(sha256sum "$reports/.pending.bin") || return 1
        seen_paths[$case_file]=yes
        digest=${digest%% *}
        [[ -z ${seen[$digest]:-} ]] || continue
        seen[$digest]=yes
        found=yes
        saved="$reports/$category-$digest"
        mv -- "$reports/.pending.bin" "$saved.bin" || return 1
        ((checked += 1))
        setsid timeout --kill-after=2s "${timeout_seconds}s" \
          valgrind --tool=memcheck --track-origins=yes \
          --leak-check=full --show-leak-kinds=all \
          --errors-for-leak-kinds=definite,indirect,possible \
          --error-limit=no --num-callers=30 -s \
          --error-exitcode=99 --log-file="$saved.log" \
          "$binary" "$saved.bin" >"$saved.stdout" 2>&1 &
        replay_pid=$!
        wait "$replay_pid"
        status=$?
        replay_pid=""
        printf '%s\n' "$status" >"$saved.status"
        ((status == 0)) || ((failures += 1))
        replay_progress
        if ((checked % 25 == 0)); then
          echo "Valgrind progress: $checked inputs checked, $failures nonzero replays."
        fi
      done
    done
    if ! kill -0 "$afl_pid" 2>/dev/null && [[ $found == no ]]; then
      replay_progress final
      wait "$afl_pid"
      afl_status=$?
      afl_pid=""
      break
    fi
    [[ $found == yes ]] || sleep "${FUZZ_POLL_INTERVAL_SECONDS:-0.5}"
  done
  # A duplicate may have left a temporary snapshot behind.
  if [[ -f "$reports/.pending.bin" ]]; then
    unlink "$reports/.pending.bin"
  fi
  echo "Valgrind: $checked inputs checked, $failures nonzero replays; $reports"
  ((afl_status == 0)) || return "$afl_status"
  ((failures == 0)) || return 99
  return 0
)
